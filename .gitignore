# ==========================================
# Dependencies & Virtual Node Environments
# ==========================================
node_modules/
.node-env/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
backend/.env*
frontend/.env*
!.env.example

# ==========================================
# Frontend Builds & Caches
# ==========================================
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.vite/
frontend/.cache/
.parcel-cache/
.turbo/

# ==========================================
# Backend Builds, Uploads & Databases
# ==========================================
backend/dist/
backend/build/
backend/uploads/*
!backend/uploads/.gitkeep
backend/*.sqlite
backend/*.sqlite3
backend/*.db

# ==========================================
# Logs & Runtime Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
.jest/

# ==========================================
# VS Code Editor Files
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ==========================================
# OS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
